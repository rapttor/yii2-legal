{
    "name": "rapttor/yii2-legal",
    "description": "Yii2 extension for multilingual legal pages, consents and privacy requests: terms, privacy, cookies, imprint, refunds, DPA and more from one company config, in 22 languages with a language switcher. Adds one-checkbox-per-item consents with proof, cookie consent, email stop and block, a privacy request form, and country restrictions for what your app does.",
    "type": "yii2-extension",
    "keywords": [
        "yii2",
        "yii2-extension",
        "legal",
        "privacy-policy",
        "terms",
        "gdpr",
        "cookies",
        "consent",
        "i18n"
    ],
    "homepage": "https://github.com/rapttor/yii2-legal",
    "license": "MIT",
    "authors": [
        {
            "name": "Rapttor",
            "homepage": "https://rapttor.com"
        }
    ],
    "support": {
        "issues": "https://github.com/rapttor/yii2-legal/issues",
        "source": "https://github.com/rapttor/yii2-legal"
    },
    "require": {
        "php": ">=8.2",
        "yiisoft/yii2": "~2.0.54",
        "rapttor/legal": "^2.7",
        "ext-mbstring": "*",
        "rapttor/yii2-metadata": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "rapttor\\yii2legal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "rapttor\\yii2legal\\tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "scripts": {
        "test": "phpunit -c phpunit.xml"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "bootstrap": "rapttor\\yii2legal\\Bootstrap"
    }
}
